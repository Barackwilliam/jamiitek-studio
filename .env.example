# Copy this file to .env for local development. Never commit .env.
# Real environment variables always take precedence over values in .env.

# Local development only. Must be False in any shared or hosted environment.
DJANGO_DEBUG=True

# Required when DJANGO_DEBUG is False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Comma-separated host names. Defaults to localhost when DJANGO_DEBUG is True.
DJANGO_ALLOWED_HOSTS=

# Comma-separated origins, e.g. https://studio.example.com (hosted environments only).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database. Leave DATABASE_URL empty to use a local SQLite file (works offline,
# costs nothing, and is what the automated tests use by default).
# For Supabase, copy the "Session pooler" connection string from
# Project Settings > Database > Connect (works on IPv4 networks), for example:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Require TLS for PostgreSQL connections. Keep True for Supabase.
DJANGO_DB_SSL_REQUIRE=True
# Seconds to keep a database connection open between requests.
DJANGO_DB_CONN_MAX_AGE=60
# Set to True only when using Supabase's transaction pooler (port 6543).
DJANGO_DB_TRANSACTION_POOLER=False
# Enable row level security on all Django tables after each migration so
# Supabase's Data API cannot read them. Do not turn this off.
DJANGO_DB_ENABLE_RLS=True

# Optional paths. Defaults are inside the project folder and ignored by Git.
# In hosted environments, point these to persistent storage outside the code.
DJANGO_SQLITE_PATH=
DJANGO_MEDIA_ROOT=
DJANGO_STATIC_ROOT=

DJANGO_TIME_ZONE=Africa/Dar_es_Salaam
DJANGO_LOG_LEVEL=INFO

# HTTPS settings (only used when DJANGO_DEBUG is False).
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=3600
# Enable only when every subdomain of your domain is served over HTTPS.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# Enable only if you intend to submit the domain to the browser HSTS preload list.
DJANGO_SECURE_HSTS_PRELOAD=False
# Set to True only when running behind a proxy that always sets X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=False
